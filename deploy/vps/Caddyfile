# Caddy tự xin chứng chỉ HTTPS (bắt buộc HTTPS để dùng GPS & camera trên điện thoại).
# Thay tên miền bằng tên miền của bạn, trỏ DNS (bản ghi A) về IP của VPS.

# Ứng dụng chấm công (thư mục build của frontend)
chamcong.congty.vn {
	root * /var/www/chamcong
	encode zstd gzip
	# config.js và sw.js không được cache để cập nhật ngay
	@nocache path /config.js /sw.js /index.html /
	header @nocache Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	file_server
}

# API Supabase tự host (Kong ở cổng 8000)
api.congty.vn {
	reverse_proxy localhost:8000
}

# (Tuỳ chọn) Supabase Studio – nên giới hạn IP
